rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー設定: 本人のみアクセス可能
    match /settings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // タスクリスト順序: 本人のみアクセス可能
    match /taskListOrder/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /shareCodes/{shareCode} {
      function canAccessTaskList(taskListId) {
        return (request.auth != null
            && exists(/databases/$(database)/documents/taskLists/$(taskListId)/members/$(request.auth.uid)))
          || (request.auth != null
            && existsAfter(/databases/$(database)/documents/taskLists/$(taskListId)/members/$(request.auth.uid)));
      }

      // 同一 commit で taskList.shareCode が自分を指すことを要求し、
      // taskList から辿れない失効不能なコードの発行を禁止する
      function isBoundToTaskList(taskListId) {
        return getAfter(/databases/$(database)/documents/taskLists/$(taskListId)).data.shareCode == shareCode;
      }

      // read ではなく get にすることで、一括取得(list)を禁止
      allow get: if resource == null
        || get(/databases/$(database)/documents/taskLists/$(resource.data.taskListId)).data.shareCode == shareCode;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['taskListId', 'createdAt'])
        && request.resource.data.taskListId is string
        && request.resource.data.createdAt is int
        && canAccessTaskList(request.resource.data.taskListId)
        && isBoundToTaskList(request.resource.data.taskListId);
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.taskListId is string
        && canAccessTaskList(resource.data.taskListId);
    }

    // タスクリスト
    match /taskLists/{taskListId} {
      function allowedTaskListKeys() {
        return ['id', 'name', 'tasks', 'history', 'shareCode', 'background', 'memberCount', 'createdAt', 'updatedAt'];
      }

      // membership document が存在するかを確認
      function isMemberBefore() {
        return request.auth != null
          && exists(/databases/$(database)/documents/taskLists/$(taskListId)/members/$(request.auth.uid));
      }

      function isMemberAfter() {
        return request.auth != null
          && existsAfter(/databases/$(database)/documents/taskLists/$(taskListId)/members/$(request.auth.uid));
      }

      function isMemberBeforeOrAfter() {
        return isMemberBefore() || isMemberAfter();
      }

      // ヘルパー関数: 有効な共有コード紐付けがあるか確認
      function isValidShareCode() {
        return resource.data.shareCode != null
          && get(/databases/$(database)/documents/shareCodes/$(resource.data.shareCode)).data.taskListId == taskListId;
      }

      function isValidMemberCountUpdate() {
        return request.resource.data.memberCount is int
          && resource.data.memberCount is int
          && request.resource.data.memberCount >= 1
          && (
            request.resource.data.memberCount == resource.data.memberCount
            || (
              request.auth != null
              && request.resource.data.memberCount == resource.data.memberCount + 1
              && !isMemberBefore()
              && isMemberAfter()
            )
            || (
              request.auth != null
              && request.resource.data.memberCount == resource.data.memberCount - 1
              && isMemberBefore()
              && !isMemberAfter()
            )
          );
      }

      function hasValidTaskListFields() {
        let background = request.resource.data.get('background', null);
        return request.resource.data.id is string
          && request.resource.data.name is string
          && request.resource.data.tasks is map
          && request.resource.data.history is list
          && request.resource.data.history.size() <= 300
          && request.resource.data.memberCount is int
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && (
            background == null
            || (background is string && background.matches('^#[0-9A-Fa-f]{6}$'))
          );
      }

      // shareCode は null か 8 桁の共有コードのみ。
      // 新しいコードを設定する場合は同一 commit で shareCodes 側が自分を指すことを要求する
      function isPreviousShareCodeRemoved() {
        let previousShareCode = resource.data.get('shareCode', null);
        return previousShareCode == null
          || !existsAfter(/databases/$(database)/documents/shareCodes/$(previousShareCode));
      }

      function isAllowedShareCodeChange() {
        let nextShareCode = request.resource.data.get('shareCode', null);
        return nextShareCode == resource.data.get('shareCode', null)
          || (isPreviousShareCodeRemoved() && (
            nextShareCode == null
            || (
              nextShareCode is string
              && nextShareCode.matches('^[A-Z0-9]{8}$')
              && getAfter(/databases/$(database)/documents/shareCodes/$(nextShareCode)).data.taskListId == taskListId
            )
          ));
      }

      match /members/{memberUid} {
        function isSelf() {
          return request.auth != null && request.auth.uid == memberUid;
        }

        function orderDocument() {
          return /databases/$(database)/documents/taskListOrder/$(memberUid);
        }

        function hasOrderEntryAfter() {
          return existsAfter(orderDocument())
            && taskListId in getAfter(orderDocument()).data;
        }

        function isOwnerCreation() {
          return !exists(/databases/$(database)/documents/taskLists/$(taskListId))
            && existsAfter(/databases/$(database)/documents/taskLists/$(taskListId))
            && getAfter(/databases/$(database)/documents/taskLists/$(taskListId)).data.memberCount == 1
            && getAfter(/databases/$(database)/documents/taskLists/$(taskListId)).data.shareCode == null
            && hasOrderEntryAfter()
            && request.resource.data.get('joinCode', null) == null;
        }

        function isShareCodeJoin() {
          let joinCode = request.resource.data.get('joinCode', null);
          return joinCode is string
            && joinCode.matches('^[A-Z0-9]{8}$')
            && get(/databases/$(database)/documents/taskLists/$(taskListId)).data.shareCode == joinCode
            && get(/databases/$(database)/documents/shareCodes/$(joinCode)).data.taskListId == taskListId
            && get(/databases/$(database)/documents/taskLists/$(taskListId)).data.memberCount is int
            && getAfter(/databases/$(database)/documents/taskLists/$(taskListId)).data.memberCount
              == get(/databases/$(database)/documents/taskLists/$(taskListId)).data.memberCount + 1
            && hasOrderEntryAfter();
        }

        allow read: if isSelf();
        allow create: if isSelf()
          && request.resource.data.keys().hasOnly(['joinedAt', 'joinCode'])
          && request.resource.data.joinedAt is int
          && (isOwnerCreation() || isShareCodeJoin());
        allow update: if isSelf() && request.resource.data == resource.data;
        allow delete: if isSelf()
          && (
            (!existsAfter(/databases/$(database)/documents/taskLists/$(taskListId))
              && !hasOrderEntryAfter())
            || (
              exists(/databases/$(database)/documents/taskLists/$(taskListId))
              && getAfter(/databases/$(database)/documents/taskLists/$(taskListId)).data.memberCount
                == get(/databases/$(database)/documents/taskLists/$(taskListId)).data.memberCount - 1
              && !hasOrderEntryAfter()
            )
          );
      }

      // 読み取り権限: membership documentに含まれている、または有効な共有コードが存在する
      allow read: if isMemberBeforeOrAfter() || isValidShareCode();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(allowedTaskListKeys())
        && hasValidTaskListFields()
        && request.resource.data.id == taskListId
        && request.resource.data.memberCount == 1
        && request.resource.data.get('shareCode', null) == null
        && existsAfter(/databases/$(database)/documents/taskLists/$(taskListId)/members/$(request.auth.uid));

      allow update: if isMemberBeforeOrAfter()
        && request.resource.data.keys().hasOnly(allowedTaskListKeys())
        && hasValidTaskListFields()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is int
        && isValidMemberCountUpdate()
        && isAllowedShareCodeChange();

      // 削除権限: 最後の保持者のみ実体削除可能
      allow delete: if isMemberBefore()
        && request.auth != null
        && !isMemberAfter()
        && resource.data.memberCount is int
        && resource.data.memberCount <= 1
        && isPreviousShareCodeRemoved();
    }
  }
}
