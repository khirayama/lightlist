# cp .env.sample .env.local
# Apple Developer > Account > Membership details の Team ID（英大文字・数字 10 文字）
LIGHTLIST_IOS_TEAM_ID=XXXXXXXXXX

# 任意: App Store Connect API key。未設定なら Xcode の Apple ID ログインを使う
# LIGHTLIST_ASC_KEY_ID=XXXXXXXXXX
# LIGHTLIST_ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 既定: ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
# LIGHTLIST_ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
