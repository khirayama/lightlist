{
  "name": "@lightlist/web",
  "version": "1.0.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^24.19.0 || >=26.0.0"
  },
  "description": "",
  "scripts": {
    "prepare:assets": "node scripts/sync-shared-locales.mjs && npm run licenses:generate",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "prelint": "npm run prepare:assets",
    "pretypecheck": "npm run prepare:assets",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "knip": "knip",
    "build": "vite build",
    "postbuild": "node scripts/write-apple-app-site-association.mjs dist --if-configured && node scripts/write-assetlinks.mjs dist --if-configured",
    "preview": "vite preview",
    "cf:build": "npm run prepare:assets && vite build && node scripts/write-apple-app-site-association.mjs dist && node scripts/write-assetlinks.mjs dist",
    "cf:preview": "npm run cf:build && wrangler pages dev dist",
    "cf:deploy": "npm run cf:build && wrangler pages deploy dist --project-name \"$CLOUDFLARE_PAGES_PROJECT_NAME\"",
    "typecheck": "tsc --noEmit",
    "screenshots:generate": "node scripts/generate-store-screenshots.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "workerd@1.20260820.1": true
  }
}
