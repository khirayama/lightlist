{
  "name": "@lightlist/web",
  "private": true,
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/prepare.ts && eslint . --max-warnings=0 && tsc --noEmit && tsc --noEmit -p tsconfig.node.json && knip",
    "format": "prettier --write .",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "screenshots": "node scripts/generate-store-screenshots.mjs"
  },
  "type": "module",
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/eslint-parser": "^8.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "workerd@1.20261019.1": true
  }
}
