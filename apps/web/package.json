{
  "name": "@lightlist/web",
  "private": true,
  "packageManager": "npm@12.2.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.3 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/prepare.ts && eslint . --max-warnings=0 && tsc --noEmit && tsc --noEmit -p tsconfig.node.json && knip",
    "format": "prettier --write .",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.3",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.3.0",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "workerd@1.20261113.1": true
  }
}
