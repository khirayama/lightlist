{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lightlist",
  "account_id": "3be94fe02250b737f7a9dcec19a3be39",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "lightlist.app", "custom_domain": true },
    { "pattern": "www.lightlist.app", "custom_domain": true },
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp"],
  },
}
